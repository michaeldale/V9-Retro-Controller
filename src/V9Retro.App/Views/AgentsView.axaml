<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:V9Retro.App.ViewModels"
             xmlns:svc="using:V9Retro.App.Services"
             x:Class="V9Retro.App.Views.AgentsView"
             x:DataType="vm:AgentsViewModel">
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <TextBlock Text="All agents" Classes="h1" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Filter}" Watermark="Filter by name, address, OS or install ID" Margin="20,0" MaxWidth="420"
               HorizontalAlignment="Left" Width="380" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Busy}" Classes="muted" VerticalAlignment="Center" />
        <Button Content="Poll" Command="{Binding PollSelectedCommand}" ToolTip.Tip="Poll the selected agents (or all shown)" />
        <Button Content="Screenshot" Command="{Binding ScreenshotSelectedCommand}" />
        <Button Content="+ Add" Command="{Binding AddCommand}" Classes="accent" />
      </StackPanel>
    </Grid>

    <DataGrid x:Name="Grid" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}" IsReadOnly="True"
              SelectionMode="Extended" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
              DoubleTapped="GridDoubleTapped" SelectionChanged="GridSelectionChanged">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open" Command="{Binding OpenCommand}" CommandParameter="{x:Null}" />
          <MenuItem Header="Edit…" Command="{Binding EditCommand}" CommandParameter="{x:Null}" />
          <MenuItem Header="Poll now" Command="{Binding PollSelectedCommand}" />
          <MenuItem Header="Take screenshot" Command="{Binding ScreenshotSelectedCommand}" />
          <MenuItem Header="Pause / resume polling" Command="{Binding ToggleEnabledCommand}" CommandParameter="{x:Null}" />
          <Separator />
          <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" CommandParameter="{x:Null}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Status" SortMemberPath="StatusOrder" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:AgentRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={x:Static svc:StatusBrushConverter.Instance}}" />
                <TextBlock Text="{Binding StatusText}" />
                <TextBlock Text="paused" Classes="muted" FontSize="11" IsVisible="{Binding !Enabled}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" x:DataType="vm:AgentRowViewModel" Width="160" />
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" x:DataType="vm:AgentRowViewModel" Width="150" />
        <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" x:DataType="vm:AgentRowViewModel" Width="120" />
        <DataGridTextColumn Header="OS" Binding="{Binding Os}" x:DataType="vm:AgentRowViewModel" Width="140" />
        <DataGridTextColumn Header="Agent" Binding="{Binding Version}" x:DataType="vm:AgentRowViewModel" Width="80" />
        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" x:DataType="vm:AgentRowViewModel" Width="200" />
        <DataGridTextColumn Header="RAM" Binding="{Binding Ram}" x:DataType="vm:AgentRowViewModel" Width="80" />
        <DataGridTemplateColumn Header="Disk used" SortMemberPath="DiskPercent" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:AgentRowViewModel">
              <StackPanel Margin="8,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Disk}" FontSize="12" />
                <ProgressBar Value="{Binding DiskPercent}" Maximum="100" MinWidth="100" Height="4" Margin="0,2,0,0"
                             IsVisible="{Binding HasDisk}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" x:DataType="vm:AgentRowViewModel" Width="90" />
        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" SortMemberPath="LastSeenSort"
                            x:DataType="vm:AgentRowViewModel" Width="100" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
