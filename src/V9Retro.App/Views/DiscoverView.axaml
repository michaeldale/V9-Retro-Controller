<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:V9Retro.App.ViewModels"
             x:Class="V9Retro.App.Views.DiscoverView"
             x:DataType="vm:DiscoverViewModel">
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <TextBlock Text="Discover" Classes="h1" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBrowsing}" VerticalAlignment="Center" />
        <Button Content="Rescan" Command="{Binding RescanCommand}" />
        <Button Content="Add all new" Command="{Binding AddAllCommand}" />
      </StackPanel>
    </Grid>
    <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="muted" Margin="0,0,0,14" TextWrapping="Wrap" />

    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserSortColumns="True"
              GridLinesVisibility="Horizontal" DoubleTapped="GridDoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" x:DataType="vm:DiscoveredRow" Width="170" />
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" x:DataType="vm:DiscoveredRow" Width="160" />
        <DataGridTextColumn Header="OS" Binding="{Binding Os}" x:DataType="vm:DiscoveredRow" Width="120" />
        <DataGridTextColumn Header="Agent" Binding="{Binding Version}" x:DataType="vm:DiscoveredRow" Width="90" />
        <DataGridTextColumn Header="Install ID" Binding="{Binding InstallId}" x:DataType="vm:DiscoveredRow" Width="290" />
        <DataGridTextColumn Header="State" Binding="{Binding State}" x:DataType="vm:DiscoveredRow" Width="160" />
        <DataGridTemplateColumn Header="" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:DiscoveredRow">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,2">
                <Button Content="Add" IsVisible="{Binding !IsKnown}"
                        Command="{Binding $parent[DataGrid].((vm:DiscoverViewModel)DataContext).AddCommand}" CommandParameter="{Binding}" />
                <Button Content="{Binding IsKnown, Converter={x:Static vm:Converters.KnownOpenLabel}}"
                        Command="{Binding $parent[DataGrid].((vm:DiscoverViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
